    {
      "type": "text",
      "id": "text-21",
      "x": 40,
      "y": 420,
      "width": 930,
      "height": 35,
      "text": "On replay, ctx.step returns the recorded result WITHOUT calling the side effect - so charge",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-22",
      "x": 40,
      "y": 452,
      "width": 930,
      "height": 35,
      "text": "does not fire twice across the crash. If replay reaches a different step than history recorded,",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-23",
      "x": 40,
      "y": 484,
      "width": 930,
      "height": 35,
      "text": "the engine raises (non-determinism caught, not hidden). Timers ride a hashed timing wheel.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
